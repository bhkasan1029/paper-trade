generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Portfolio {
  id           String   @id @default(cuid())
  name         String
  currency     String   @default("INR")
  startingCash Decimal  @default(1000000) @db.Decimal(18, 2)
  cashBalance  Decimal  @default(1000000) @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trades Trade[]
  notes  Note[]
}

enum AssetType {
  STOCK
  OPTION
}

enum TradeSide {
  BUY
  SELL
}

model Trade {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  symbol     String
  assetType  AssetType
  side       TradeSide
  quantity   Decimal   @db.Decimal(18, 4)
  price      Decimal   @db.Decimal(18, 4)

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  closePrice Decimal?  @db.Decimal(18, 4)

  // For options: { strike, expiration, type: 'call'|'put', contractSymbol }
  optionDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@index([symbol])
}

model Note {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  // Optional: pin a note to a specific ticker within the portfolio
  symbol String?
  body   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String   @unique
  name      String?
  exchange  String?
  createdAt DateTime @default(now())

  @@index([symbol])
}
